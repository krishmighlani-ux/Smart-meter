# --- MongoDB (leave MONGODB_URI empty/unset to run with in-memory SIMULATED demo data) ---
MONGODB_URI=
MONGODB_DB=smartmeter

# --- Python ML service ---
ML_SERVICE_URL=http://127.0.0.1:8001
# Optional shared secret: set the same value for the web app and the ML service
ML_SERVICE_TOKEN=

# --- Device ingestion (ESP32 -> POST /api/readings). Generate a long random value. ---
INGEST_API_KEY=
